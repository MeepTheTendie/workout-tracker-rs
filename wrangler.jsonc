{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-tracker-rs",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-21",
  "build": {
    "command": "bash -c 'source /home/meep/.cargo/env && /home/meep/.cargo/bin/worker-build --release'"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "myworkouttracker.xyz", "custom_domain": true },
    { "pattern": "www.myworkouttracker.xyz", "custom_domain": true }
  ],
  "workers_dev": true,
  "vars": {
    "SESSION_LIFETIME": "3600"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workout-tracker-rs",
      "database_id": "58baecb1-9c88-4b3f-8da9-e970faa5440b"
    }
  ]
}